#include <iostream>
#include <string>
#include <vector>
#include <unordered_map>
#include <iomanip>

using namespace std;

class Book {
public:
    Book(const string& isbn, const string& title, const vector<string>& authors, double price)
        : isbn(isbn), title(title), authors(authors), price(price) {}

    string getISBN() const {
        return isbn;
    }

    string getTitle() const {
        return title;
    }

    double getPrice() const {
        return price;
    }

    void display() const {
        cout << "ISBN: " << isbn << ", Title: " << title << ", Authors: ";
        for (const auto& author : authors) {
            cout << author << " ";
        }
        cout << ", Price: $" << fixed << setprecision(2) << price << endl;
    }

private:
    string isbn;
    string title;
    vector<string> authors;
    double price;
};

class BookStore {
public:
    void addBook(const Book& book, int quantity) {
        inventory[book.getISBN()] += quantity;
        books[book.getISBN()] = book;
    }

    vector<string> books() const {
        vector<string> isbns;
        for (const auto& pair : inventory) {
            isbns.push_back(pair.first);
        }
        return isbns;
    }

    int noOfCopies(const string& isbn) const {
        auto it = inventory.find(isbn);
        return (it != inventory.end()) ? it->second : 0;
    }

    double totalPrice() const {
        double total = 0.0;
        for (const auto& pair : inventory) {
            const Book& book = books.at(pair.first);
            total += book.getPrice() * pair.second;
        }
        return total;
    }

    void printInventory() const {
        for (const auto& pair : inventory) {
            const Book& book = books.at(pair.first);
            cout << "Title: " << book.getTitle() << ", Copies: " << pair.second << endl;
        }
    }

private:
    unordered_map<string, int> inventory; // ISBN to quantity mapping
    unordered_map<string, Book> books;    // ISBN to Book mapping
};

int main() {
    // Create some books
    Book book1("12345", "The Great Gatsby", {"F. Scott Fitzgerald"}, 10.99);
    Book book2("67890", "1984", {"George Orwell"}, 8.99);
    Book book3("54321", "To Kill a Mockingbird", {"Harper Lee"}, 12.99);

    // Create a bookstore
    BookStore store;
    store.addBook(book1, 3); // 3 copies of book1
    store.addBook(book2, 5); // 5 copies of book2
    store.addBook(book3, 2); // 2 copies of book3

    // Print inventory
    store.printInventory();

    // Print total price of all books
    cout << "Total Price of all books: $" << fixed << setprecision(2) << store.totalPrice() << endl;

    // Print number of copies for each book
    for (const auto& isbn : store.books()) {
        cout << "ISBN: " << isbn << ", Copies: " << store.noOfCopies(isbn) << endl;
    }

    return 0;
}
